# 複製為 .env.local 並填入實際值（.env.local 不會入版本庫）

# Supabase —— 與消費者站相同專案
NEXT_PUBLIC_SUPABASE_URL=https://tkgxdzvsnmereaygddaz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# 僅伺服器端使用（審核/管理特權操作）—— 機密，切勿外露
SUPABASE_SERVICE_ROLE_KEY=

# Shopify —— 新系統 OAuth（一次性授權取得 offline token）
SHOPIFY_STORE_DOMAIN=xxx.myshopify.com
SHOPIFY_API_KEY=            # dev dashboard 憑證 → 用戶端 ID (client id)
SHOPIFY_API_SECRET=        # dev dashboard 憑證 → 密碼 (client secret)
SHOPIFY_ADMIN_API_TOKEN=   # 完成 /api/shopify/install 後由 callback 頁顯示
SHOPIFY_WEBHOOK_SECRET=    # 可留空；預設用 SHOPIFY_API_SECRET 驗證 webhook HMAC
